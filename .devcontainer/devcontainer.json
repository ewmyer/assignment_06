{
  "name": "IST356 Assignment 06",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "forwardPorts": [28888, 28501, 28502, 28000],
  "portsAttributes": {
    "28888": { "label": "Jupyter" },
    "28501": { "label": "Streamlit" },
    "28502": { "label": "Streamlit (launch config)" },
    "28000": { "label": "FastAPI" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.black-formatter",
        "ms-python.pylint",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
